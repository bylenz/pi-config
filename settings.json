{
  "lastChangelogVersion": "0.84.3",
  "theme": "dark",
  "defaultProvider": "zai",
  "defaultModel": "glm-5.3",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "git:github.com/DietrichGebert/ponytail",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-subagents",
    "npm:gentle-engram@0.1.8",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-image-tools",
    "npm:pi-usage-meters"
  ],
  "subagents": {
    "agentOverrides": {
      "worker": {
        "model": "zai/glm-5.3"
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-luna"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol"
      },
      "researcher": {
        "model": "zai/glm-5.3"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-sol"
      },
      "delegate": {
        "model": "zai/glm-5.3"
      }
    }
  },
  "hideThinkingBlock": true
}
